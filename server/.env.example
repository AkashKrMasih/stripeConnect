# Platform (your) Stripe keys — test mode
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Connected account IDs (acct_...) from Stripe Dashboard → Connect → Accounts
STRIPE_CONNECTED_ACCOUNT_A=acct_...
STRIPE_CONNECTED_ACCOUNT_B=acct_...

# Optional: webhook signing secret if you enable webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

PORT=4242
CLIENT_URL=http://localhost:5173
